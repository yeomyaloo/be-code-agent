# .env 로 복사해서 쓴다 (cp .env.example .env). .env 는 git 에 올라가지 않는다.

# 에이전트 분석에 필요한 Anthropic API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# PostgreSQL 비밀번호 (컨테이너 안에서만 쓰인다)
DB_PASSWORD=codeagent

# 웹 화면 포트 → http://localhost:3000
WEB_PORT=3000
# 백엔드 API 포트 (이 컴퓨터에서만 열림)
API_PORT=8080

# "서버 폴더 경로"로 등록할 로컬 저장소들을 둔 폴더. 컨테이너 안에서는 /repos 로 보인다 (읽기 전용)
LOCAL_REPOS_DIR=./repos

# 웹 화면 소스. 로컬에서 고친 프론트를 쓰려면 폴더 경로로 바꾼다 (예: ../fe-code-agent)
WEB_SOURCE=https://github.com/yeomyaloo/fe-code-agent.git#main
